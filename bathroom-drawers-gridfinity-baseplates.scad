include <modules/gridfinity-extended.scad>

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// measurements

drawer_x = 176;
drawer_y = 420;
drawer_z = 70;

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// settings

render_mode = "print";

drawer_plate_1_y = 250;

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// calculations

drawer_grid_cells_x = floor( drawer_x / gf_pitch );
echo( "drawer_grid_cells_x: ", drawer_grid_cells_x );

drawer_plate_1_grid_cells_y = floor( drawer_plate_1_y / gf_pitch );
echo( "drawer_plate_1_grid_cells_y: ", drawer_plate_1_grid_cells_y, " = ", drawer_plate_1_grid_cells_y * gf_pitch );

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// models

if( render_mode == "print" )
{
    BathroomDrawerBaseplate();
}
else
{
    assert( false, str( "Unknown render mode: ", render_mode ) );
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

module BathroomDrawerBaseplate()
{
    GridfinityBaseplateSnugFitInto( drawer_x, 0, drawer_grid_cells_x, drawer_plate_1_grid_cells_y );
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
