include <modules/utils.scad>

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// measurements

recycling_can_hinge_pin_r = 23.0 / 2;
recycling_can_hinge_pin_z = 120.0;

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// settings

render_mode = "preview";
// render_mode = "mo-model";

recycling_can_hinge_pin_base_extra_r = 6.0;
recycling_can_hinge_pin_base_z = 3.0;

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// calculations

$fn = $preview ? 32 : 128;

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// models

if( render_mode == "preview" )
{
    MyModel();
}
else if( render_mode == "my-model" )
{
    MyModel();
}
else
{
    assert( false, str( "Unknown render mode: ", render_mode ) );
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

module MyModel()
{
    // base
    cylinder(
        r = recycling_can_hinge_pin_r + recycling_can_hinge_pin_base_extra_r,
        h = recycling_can_hinge_pin_base_z
        );

    // main pin
    translate([ 0, 0, recycling_can_hinge_pin_base_z ])
        cylinder(
            r = recycling_can_hinge_pin_r,
            h = recycling_can_hinge_pin_z
            );
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
